<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaRepasoA.Views.vTres"
             Title="vTres">

    <VerticalStackLayout>
        <Label
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center"
            HorizontalOptions="Center" />
    </VerticalStackLayout>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label Text="Desarrollado"
               Grid.Row="0"
               Grid.Column="0"/>
        <Entry x:Name="txtDesarrollado"
               IsEnabled="False"
               Grid.Row="0"
               Grid.Column="1"/>

        <Label Text="Asignatura"
       Grid.Row="0"
       Grid.Column="1"/>
        <Entry x:Name="txtAsignatura"
       IsEnabled="False"
       Grid.Row="1"
       Grid.Column="1"/>

        <Label Text="Nivel"
       Grid.Row="2"
       Grid.Column="0"/>
        <Entry x:Name="txtNivel"
       IsEnabled="False"
       Grid.Row="2"
       Grid.Column="0"/>


        <Label Text="Nora final p1"
               Style="{StaticResource LabelGlobal}"
       Grid.Row="3"
       Grid.Column="0"/>
        <Entry x:Name="txtFinal"
       IsReadOnly="True"
       Grid.Row="3"
       Grid.Column="1"/>
    </Grid>

</ContentPage>